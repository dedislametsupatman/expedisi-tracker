# ── MySQL Database ────────────────────────────────────────────────────────────
# Dokploy: set these in Environment Variables tab
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expedisi_tracker
DB_USER=root
DB_PASS=your_password_here

# ── Brevo Email (Brevo SMTP API) ────────────────────────────────────────────
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# ── Shipping Cost API (api.co.id) ──────────────────────────────────────────
# Get from: https://use.api.co.id/
API_CO_ID_KEY=YOUR_API_CO_ID_KEY_HERE

# ── Rajaongkir (Komerce - fallback) ───────────────────────────────────────
# Get from: https://rajaongkir.com/document/api
RAJAONGKIR_KEY=YOUR_RAJAONGKIR_KEY_HERE

# ── App URL (used in email links) ─────────────────────────────────────────────
APP_URL=http://localhost:3000
SENDER_EMAIL=noreply@expedisi.aplikasirt.my.id
SENDER_NAME=LacakOngkir

# ── OAuth (Optional - for Google/GitHub login) ─────────────────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# GitHub: https://github.com/settings/developers → OAuth Apps
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_secret
